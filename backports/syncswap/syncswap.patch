+
+/*
+ * KKNX (Linux 4.15): счётчик ссылок на слот без swap cache.
+ * Читаем под si->lock: swapoff обнуляет max и swap_map под этим же замком,
+ * после чего возвращаем 0 и вызывающий идёт обычным путём через swapin_readahead().
+ */
+int __swap_count(struct swap_info_struct *si, swp_entry_t entry)
+{
+	pgoff_t offset = swp_offset(entry);
+	int count = 0;
+
+	spin_lock(&si->lock);
+	if (si->swap_map && offset < si->max)
+		count = swap_count(si->swap_map[offset]);
+	spin_unlock(&si->lock);
+	return count;
 }
 
