+/*
+ * util_est (Linux 4.17): оценка загрузки по прошлым активациям задачи.
+ * @enqueued: у задачи - загрузка на момент последней записи; у корневого cfs_rq - сумма оценок поставленных в очередь задач
+ * @ewma:     у задачи - скользящее среднее загрузки по активациям
+ */
+struct util_est {
+	unsigned int			enqueued;
+	unsigned int			ewma;
+#define UTIL_EST_WEIGHT_SHIFT		2
+};
+
 struct sched_avg {
 	u64 last_update_time, load_sum;
 	u32 util_sum, period_contrib;
 	unsigned long load_avg, util_avg;
+	struct util_est util_est;
 };
 
