@@ -5022,6 +5028,70 @@
 static unsigned long cpu_util(int cpu);
 #endif
 
+#ifdef CONFIG_SMP
+/*
+ * util_est: бэкпорт Linux 4.17 ("sched/fair: Add util_est on top of PELT"), вариант 5.x:
+ * вычитание при dequeue до пересчёта частоты, обновление скользящего среднего после.
+ * Учёт ведётся всегда; sysctl sched_util_est только решает, читает ли его schedutil.
+ */
+static inline unsigned long _task_util_est(struct task_struct *p)
+{
+	unsigned int ewma = READ_ONCE(p->se.avg.util_est.ewma);
+	unsigned int enq = READ_ONCE(p->se.avg.util_est.enqueued);
+
+	return max(ewma, enq);
+}
+
+static inline bool util_est_within_margin(int value, int margin)
+{
+	return ((unsigned int)(value + margin - 1) < (2 * margin - 1));
+}
+
+static inline void util_est_enqueue(struct cfs_rq *cfs_rq, struct task_struct *p)
+{
+	unsigned int enqueued = cfs_rq->avg.util_est.enqueued;
+
+	enqueued += _task_util_est(p);
+	WRITE_ONCE(cfs_rq->avg.util_est.enqueued, enqueued);
+}
+
+static inline void util_est_dequeue(struct cfs_rq *cfs_rq, struct task_struct *p)
+{
+	unsigned int enqueued = cfs_rq->avg.util_est.enqueued;
+
+	enqueued -= min_t(unsigned int, enqueued, _task_util_est(p));
+	WRITE_ONCE(cfs_rq->avg.util_est.enqueued, enqueued);
+}
+
+static inline void util_est_update(struct task_struct *p, bool task_sleep)
+{
+	long last_ewma_diff;
+	unsigned int last_util, ewma;
+
+	/* Задача не закончила активацию (миграция, смена класса): не обновляем */
+	if (!task_sleep)
+		return;
+
+	ewma = p->se.avg.util_est.ewma;
+	last_util = task_util(p);
+	last_ewma_diff = (long)last_util - (long)ewma;
+
+	/* Среднее уже в пределах ~1% от последней активации */
+	if (util_est_within_margin(last_ewma_diff, SCHED_CAPACITY_SCALE / 100))
+		return;
+
+	ewma <<= UTIL_EST_WEIGHT_SHIFT;
+	ewma += last_ewma_diff;
+	ewma >>= UTIL_EST_WEIGHT_SHIFT;
+	WRITE_ONCE(p->se.avg.util_est.enqueued, last_util);
+	WRITE_ONCE(p->se.avg.util_est.ewma, ewma);
+}
+#else
+static inline void util_est_enqueue(struct cfs_rq *cfs_rq, struct task_struct *p) {}
+static inline void util_est_dequeue(struct cfs_rq *cfs_rq, struct task_struct *p) {}
+static inline void util_est_update(struct task_struct *p, bool task_sleep) {}
+#endif /* CONFIG_SMP */
+
