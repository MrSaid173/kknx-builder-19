diff -urN a/fs/f2fs/compat54.h b/fs/f2fs/compat54.h
--- a/fs/f2fs/compat54.h
+++ b/fs/f2fs/compat54.h
@@ -0,0 +1,85 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Заглушки для fs/f2fs уровня Linux 5.4 на ядре 4.9 (kknx-builder).
+ *
+ * В 5.4 в f2fs добавлены fs-verity и casefold (fs/unicode). Ни того, ни другого в
+ * ядре 4.9 нет, переносить их целиком нельзя (нужны правки VFS). Код остаётся от 5.4,
+ * но ветки verity и casefold выключены:
+ *  - verity: fsverity_active() всегда false, ioctl'ы возвращают -EOPNOTSUPP;
+ *  - casefold: CONFIG_UNICODE не определён, IS_CASEFOLDED() всегда 0. Раздел /data с
+ *    включённым casefold такое ядро не смонтирует (так же, как и 5.4 без CONFIG_UNICODE).
+ */
+#ifndef _F2FS_COMPAT54_H
+#define _F2FS_COMPAT54_H
+
+#include <linux/fs.h>
+#include <linux/bio.h>
+#include <linux/ioctl.h>
+#include <linux/workqueue.h>
+
+#ifndef S_VERITY
+#define S_VERITY		0
+#endif
+#ifndef S_CASEFOLD
+#define S_CASEFOLD		0
+#endif
+#ifndef FS_CASEFOLD_FL
+#define FS_CASEFOLD_FL		0x40000000
+#endif
+#ifndef IS_VERITY
+#define IS_VERITY(inode)	0
+#endif
+#ifndef IS_CASEFOLDED
+#define IS_CASEFOLDED(inode)	0
+#endif
+
+struct fsverity_operations;
+struct unicode_map;
+
+#ifndef FS_IOC_ENABLE_VERITY
+#define FS_IOC_ENABLE_VERITY	_IO('f', 133)
+#define FS_IOC_MEASURE_VERITY	_IO('f', 134)
+#endif
+
+/* fscrypt_drop_inode() (5.4) нужен только для ключей v2; на 4.9 их нет, inode выбрасывается как обычно */
+static inline int fscrypt_drop_inode(struct inode *inode) { return 0; }
+
+static inline bool fsverity_active(const struct inode *inode) { return false; }
+static inline int fsverity_file_open(struct inode *inode, struct file *filp) { return 0; }
+static inline int fsverity_prepare_setattr(struct dentry *dentry, struct iattr *attr) { return 0; }
+static inline void fsverity_cleanup_inode(struct inode *inode) { }
+static inline int fsverity_ioctl_enable(struct file *filp, const void __user *arg) { return -EOPNOTSUPP; }
+static inline int fsverity_ioctl_measure(struct file *filp, void __user *arg) { return -EOPNOTSUPP; }
+static inline bool fsverity_verify_page(struct page *page) { return true; }
+static inline void fsverity_verify_bio(struct bio *bio) { }
+static inline void fsverity_enqueue_verify_work(struct work_struct *work) { }
+
+/* FS_IOC_GETFSLABEL / SETFSLABEL (uapi 4.18+): те же номера, что в mainline */
+#ifndef FSLABEL_MAX
+#define FSLABEL_MAX		256
+#define FS_IOC_GETFSLABEL	_IOR(0x94, 49, char[FSLABEL_MAX])
+#define FS_IOC_SETFSLABEL	_IOW(0x94, 50, char[FSLABEL_MAX])
+#endif
+
+#ifndef FS_VERITY_FL
+#define FS_VERITY_FL		0x00100000
+#endif
+
+/*
+ * fscrypt v2 (5.4): ключи через FS_IOC_ADD_ENCRYPTION_KEY и т. п. В fs/crypto 4.9 их нет.
+ * Номера условные, обработчики возвращают -EOPNOTSUPP. FBE на 4.9 работает через keyring v1 как раньше.
+ */
+#ifndef FS_IOC_ADD_ENCRYPTION_KEY
+#define FS_IOC_GET_ENCRYPTION_POLICY_EX		_IO('f', 22)
+#define FS_IOC_ADD_ENCRYPTION_KEY		_IO('f', 23)
+#define FS_IOC_REMOVE_ENCRYPTION_KEY		_IO('f', 24)
+#define FS_IOC_REMOVE_ENCRYPTION_KEY_ALL_USERS	_IO('f', 25)
+#define FS_IOC_GET_ENCRYPTION_KEY_STATUS	_IO('f', 26)
+#endif
+static inline int fscrypt_ioctl_get_policy_ex(struct file *filp, void __user *arg) { return -EOPNOTSUPP; }
+static inline int fscrypt_ioctl_add_key(struct file *filp, void __user *arg) { return -EOPNOTSUPP; }
+static inline int fscrypt_ioctl_remove_key(struct file *filp, void __user *arg) { return -EOPNOTSUPP; }
+static inline int fscrypt_ioctl_remove_key_all_users(struct file *filp, void __user *arg) { return -EOPNOTSUPP; }
+static inline int fscrypt_ioctl_get_key_status(struct file *filp, void __user *arg) { return -EOPNOTSUPP; }
+
+#endif /* _F2FS_COMPAT54_H */
